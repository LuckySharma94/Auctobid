# Copy this file to .env and fill it in.
PORT=5000

# Local MongoDB:
MONGO_URI=mongodb://127.0.0.1:27017/auctobid
# MongoDB Atlas (replace user, password, cluster; URL-encode special characters in the password):
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/auctobid?retryWrites=true&w=majority

# Any long random string. Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Optional: comma separated list of frontend origins allowed by CORS (empty = allow all).
CLIENT_ORIGIN=

# Load demo accounts and sample auctions on first start when the database is empty (true/false).
AUTO_SEED=true
